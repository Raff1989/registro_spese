{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",

  "productName": "Registro Spese",
  "version": "1.0.3",
  "identifier": "com.registro.spese",

  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },

  "app": {
    "windows": [
      {
        "title": "Registro Spese",
        "width": 1100,
        "height": 750,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },

  "plugins": {
    "fs": {
      "scope": ["$APPDATA/registro-spese/*"]
    },
    "shell": {
      "open": true
    },
    "notification": {
      "default": true
    },
    "tray": {
      "iconPath": "icons/tray-icon.png"
    },

    "updater": {
      "active": true,
      "endpoints": [
        "https://raw.githubusercontent.com/Raff1989/registro_spese/main/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNBOEQ3NUFEN0I4M0NCRkUKUldUK3k0TjdyWFdOT3R1VW1Kc2VMNHJiSXhQY1NDVklDeEFzNDBiSVpzZGV5WnQyMGZMdzZVSlUK"
    }
  },

  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
